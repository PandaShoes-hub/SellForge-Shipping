// Base de dados da SellForge Shipping

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model License {
  id               String    @id @default(cuid())
  shop             String    @unique
  company          String?
  active           Boolean   @default(true)

  trilhosEnabled   Boolean   @default(true)
  trilhosPtService String    @default("GOLD")
  trilhosEsService String    @default("24ES")
  cttEnabled       Boolean   @default(false)
  upsEnabled       Boolean   @default(false)

  // NextLog, independente da Trilhos. Serviços configuráveis por cliente.
  nextlogEnabled   Boolean   @default(false)
  nextlogPtService String    @default("CTT48H")
  nextlogEsService String    @default("CTT24H")
  nextlogSenderName       String @default("")
  nextlogSenderAddress    String @default("")
  nextlogSenderPostalCode String @default("")
  nextlogSenderCity       String @default("")
  nextlogSenderCountry    String @default("")
  nextlogSenderPhone      String @default("")
  nextlogSenderContact    String @default("")
  nextlogSenderNif        String @default("")
  nextlogDefaultVolumes   Int    @default(1)
  nextlogDefaultWeight    Float  @default(1)

  expiresAt        DateTime?
  lastAccessAt     DateTime?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}
